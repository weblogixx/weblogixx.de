---
/**
 * An abbreviation with its expansion: <Abbr title="Common Gateway Interface">CGI</Abbr>.
 * Shows the expansion in the shared tooltip (Tooltip.astro), and on touch in the bottom sheet
 * on tap (TipSheet.astro), unlike the plain `title` (kept as the no-JS / old-browser
 * fallback). Styles: global.css.
 * When to use it (vs. `code`): AGENTS.md → Writing content.
 */
interface Props {
  /** The written-out form. */
  title: string;
}
const { title }: Props = Astro.props;
const tip = JSON.stringify({ text: title, label: '', items: [] });
---

<abbr title={title} data-tip={tip} tabindex="0"><slot /></abbr>
