---
import type { Locale } from '../data/types';
import { profile } from '../data';
import { route, routes, href, type RouteKey } from '../i18n/routes';
import { useT } from '../i18n/ui';
import ModeToggle from './ModeToggle.astro';

interface Props {
  lang: Locale;
  page: RouteKey;
  /** Path of this page in the other language, if it differs from the route map (e.g. blog posts). */
  altPath?: string;
}
const { lang, page, altPath } = Astro.props;
const t = useT(lang);
const other: Locale = lang === 'de' ? 'en' : 'de';
const items: RouteKey[] = ['home', 'about', 'career', 'blog', 'links'];
const switchHref = altPath ?? href(routes[page][other]);
---

<header class="header" data-header>
  <div class="container bar">
    <a class="brand" href={route('home', lang)} aria-label={profile.name}>
      <span class="mark" aria-hidden="true"></span>
      <span class="name">{profile.handle}</span>
    </a>

    <nav id="site-nav" aria-label={t('nav.menu')}>
      <ul>
        {
          items.map((key) => (
            <li>
              <a href={route(key, lang)} aria-current={key === page ? 'page' : undefined}>
                {t(`nav.${key}`)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ModeToggle lang={lang} />

    <a class="lang" href={switchHref} hreflang={other} lang={other} aria-label={t('lang.switchLabel')}>
      {other.toUpperCase()}
    </a>

    <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false">
      <span class="visually-hidden">{t('nav.toggle')}</span>
      <span class="burger" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('nav');

  if (header && toggle && nav) {
    // The collapsed layout is CSS (:root[data-js], set before first paint) — no layout jump here.

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.toggleAttribute('data-open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) setOpen(false);
    });
    matchMedia('(min-width: 721px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: oklch(from var(--bg) l c h / 0.82);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 4rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--step--1);
    flex-shrink: 0;
  }
  .mark {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 7px;
    background:
      /* Same artwork as /logos/weblogixx.svg: bands 58–65, 69–87, 91–98 measured from the
         bottom-left corner, mapped onto a 45° gradient (0% = bottom-left): position = band / 2. */
      linear-gradient(
        45deg,
        transparent 29%,
        var(--accent) 29% 32.5%,
        transparent 32.5% 34.5%,
        var(--accent) 34.5% 43.5%,
        transparent 43.5% 45.5%,
        var(--accent) 45.5% 49%,
        transparent 49%
      ),
      var(--primary-fill);
  }
  nav {
    margin-inline-start: auto;
  }
  ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-s);
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--text);
    background: var(--surface);
  }
  nav a[aria-current='page'] {
    color: var(--primary);
    background: var(--primary-soft);
  }
  .lang {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    flex-shrink: 0;
  }
  .lang:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform 200ms,
      background 200ms;
  }
  .burger {
    position: relative;
  }
  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .burger::before {
    transform: translateY(-6px);
  }
  .burger::after {
    transform: translateY(6px);
  }
  [data-open] .burger {
    background: transparent;
  }
  [data-open] .burger::before {
    transform: rotate(45deg);
  }
  [data-open] .burger::after {
    transform: rotate(-45deg);
  }

  /* ---- Small screens ---- */
  @media (max-width: 720px) {
    .bar {
      gap: var(--space-3);
    }
    .brand {
      margin-inline-end: auto;
    }

    /* Without JS: nav wraps into a scrollable second row. */
    :global(:root:not([data-js])) .header .bar {
      flex-wrap: wrap;
      padding-block: var(--space-2);
    }
    :global(:root:not([data-js])) .header nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
    }

    /* With JS: collapsible panel. */
    :global(:root[data-js]) .header .menu-toggle {
      display: grid;
    }
    :global(:root[data-js]) .header nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      padding: var(--space-3) var(--gutter) var(--space-5);
      background: var(--bg-raised);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 1.5rem 3rem var(--shadow);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.5rem);
      transition:
        opacity 200ms,
        transform 200ms,
        visibility 0s 200ms;
    }
    :global(:root[data-js]) [data-open] nav {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 200ms,
        transform 200ms;
    }
    :global(:root[data-js]) .header ul {
      flex-direction: column;
      gap: var(--space-1);
    }
    :global(:root[data-js]) .header nav a {
      padding: var(--space-3) var(--space-4);
      font-size: var(--step-1);
      font-family: var(--font-display);
      font-weight: 600;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(:root[data-js]) .header nav,
    .burger,
    .burger::before,
    .burger::after {
      transition: none !important;
    }
  }
</style>
