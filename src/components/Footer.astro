---
import type { Locale } from '../data/types';
import { profile } from '../data';
import { useT } from '../i18n/ui';
import { route, blogPostPath } from '../i18n/routes';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container row">
    <p class="meta">
      © {year} {profile.name}
      <span class="sep" aria-hidden="true">·</span>
      <a class="legal" href={route('imprint', lang)}>{t('footer.imprint')}</a>
      <span class="sep" aria-hidden="true">·</span>
      <a class="legal" href={route('privacy', lang)}>{t('footer.privacy')}</a>
    </p>
    <p class="theme" aria-live="polite">
      <span class="swatch" aria-hidden="true"></span>
      {t('theme.label')}: <a href={blogPostPath('sunny-theme', lang)} data-theme-label>Sunny</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    /* Clear of the home indicator (viewport-fit=cover in Base.astro). */
    padding-bottom: env(safe-area-inset-bottom, 0px);
    border-top: 1px solid var(--border);
    color: var(--text-subtle);
    font-size: var(--step--1);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-5);

    /* Small phones: everything stacked. */
    @media (max-width: 480px) {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
  /* Copyright · Impressum · Datenschutz: even spacing around the dots, and on narrow
     screens it wraps between the items instead of inside them. */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);

    /* Small phones: one item per line. */
    @media (max-width: 480px) {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
  /* The dots only make sense side by side. */
  .sep {
    @media (max-width: 480px) {
      display: none;
    }
  }
  /* Quiet like the copyright next to it; primary on hover. */
  .legal {
    color: inherit;

    &:hover {
      color: var(--primary);
    }
  }
  .theme {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
  }
  .swatch {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    /* Split along the same 45° diagonal as the stripes, red towards the bottom-left like the logo. */
    background: linear-gradient(225deg, var(--primary-fill) 55%, var(--accent) 55%);
  }
</style>
