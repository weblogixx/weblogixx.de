---
import type { Locale } from '../data/types';
import { profile } from '../data';
import { useT } from '../i18n/ui';
import { route } from '../i18n/routes';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container row">
    <p>© {year} {profile.name}</p>
    <p class="theme" aria-live="polite">
      <span class="swatch" aria-hidden="true"></span>
      {t('theme.label')}: <a href={route('about', lang, 'about-the-sunny-theme')} data-theme-label>Sunny</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    color: var(--text-subtle);
    font-size: var(--step--1);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-5);
  }
  .theme {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
  }
  .swatch {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    /* Split along the same 45° diagonal as the stripes, red towards the bottom-left like the logo. */
    background: linear-gradient(225deg, var(--primary-fill) 55%, var(--accent) 55%);
  }
</style>
