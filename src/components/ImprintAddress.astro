---
/**
 * Postal address from src/data/imprint.ts, for the MDX imprint and privacy pages.
 * Stops the production build while the imprint still has placeholders.
 */
import { imprint, assertImprintComplete } from '../data/imprint';

interface Props {
  /** Include the business name (default: yes). */
  business?: boolean;
  /** Country line, e.g. "Deutschland". */
  country?: string;
  /** Label for an e-mail line, e.g. "E-Mail"; omit for no e-mail line. */
  email?: string;
}
const { business = true, country, email } = Astro.props;

assertImprintComplete();
---

<address>
  {imprint.name}<br />
  {business && imprint.business && (<>{imprint.business}<br /></>)}
  {imprint.street}<br />
  {imprint.postalCode} {imprint.city}
  {country && (<><br />{country}</>)}
  {email && (<><br />{email}: <a href={`mailto:${imprint.email}`}>{imprint.email}</a></>)}
</address>
