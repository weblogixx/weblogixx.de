---
import type { Locale } from '../data/types';
import { useT } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const t = useT(Astro.props.lang);
---

<button class="mode-toggle" type="button" aria-pressed="false" data-mode-toggle hidden>
  <span class="visually-hidden">{t('mode.light')}</span>
  <!-- sun: shown in dark mode (→ switch to light) -->
  <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <!-- moon: shown in light mode (→ switch to dark) -->
  <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
  </svg>
</button>

<script>
  const KEY = 'vintera-mode';
  const THEME_COLORS = { dark: '#1c1813', light: '#faf6ee' } as const;
  const root = document.documentElement;
  const systemLight = matchMedia('(prefers-color-scheme: light)');

  /** Effective mode: pinned via data-mode, otherwise the OS setting. */
  const isLight = () => (root.dataset.mode ? root.dataset.mode === 'light' : systemLight.matches);

  const syncButtons = () => {
    for (const b of document.querySelectorAll('[data-mode-toggle]')) {
      b.setAttribute('aria-pressed', String(isLight()));
    }
  };

  const apply = (light: boolean) => {
    // Choosing what the OS already prefers = back to "follow system".
    const followSystem = light === systemLight.matches;
    let stored = false;
    try {
      if (followSystem) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, light ? 'light' : 'dark');
      stored = true;
    } catch {
      // storage unavailable (private mode etc.) — pin it for this page only
    }
    if (followSystem && stored) delete root.dataset.mode;
    else root.dataset.mode = light ? 'light' : 'dark';

    for (const m of document.querySelectorAll('meta[name="theme-color"]')) {
      const media = m.getAttribute('media') ?? '';
      const ownMode = media.includes('light') ? 'light' : 'dark';
      m.setAttribute('content', THEME_COLORS[root.dataset.mode ? (light ? 'light' : 'dark') : ownMode]);
    }
    syncButtons();
    target = undefined; // applied → the DOM is the source of truth again
  };

  systemLight.addEventListener('change', syncButtons);

  // Tracked synchronously: view-transition callbacks run on the next frame,
  // so reading the DOM on a quick second click could see stale state.
  let target: boolean | undefined;

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-mode-toggle]')) {
    button.hidden = false;
    button.addEventListener('click', () => {
      const next = !(target ?? isLight());
      target = next;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (document.startViewTransition && !reduce) {
        document.startViewTransition(() => apply(next));
      } else {
        apply(next);
      }
    });
  }
  syncButtons();
</script>

<style>
  .mode-toggle {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .mode-toggle:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .mode-toggle[hidden] {
    display: none;
  }
  .icon {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Dark: show the sun (→ light). Light: show the moon (→ dark). */
  .moon {
    display: none;
  }
  :global([data-mode='light']) .sun {
    display: none;
  }
  :global([data-mode='light']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-mode='dark'])) .sun {
      display: none;
    }
    :global(:root:not([data-mode='dark'])) .moon {
      display: block;
    }
  }
</style>
