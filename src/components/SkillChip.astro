---
import type { SkillTip } from '../i18n/skillTip';

interface Props {
  name: string;
  /** Anchor id, so other pages can deep-link to this chip. */
  id?: string;
  /** Turns the chip into a link. */
  href?: string;
  since?: number;
  sinceLabel?: string;
  /** Last year used. Turns "since 2004" into a span "2004–2012". */
  until?: number;
  /** Tooltip content: description, "Used when working for" + companies, legacy note. */
  tip?: SkillTip;
  /** Highlight: primary border and tint (no extra element, so the chip keeps its size). */
  featured?: boolean;
  /** Discontinued tool: muted look. */
  legacy?: boolean;
}
const { name, id, href, since, sinceLabel, until, tip, featured, legacy } = Astro.props;
const Tag = href ? 'a' : 'span';
// Plain `title` is the no-JS / old-browser fallback; Tooltip.astro swaps it for the rich version.
const title = tip
  ? [tip.text, tip.items.length && `${tip.label}: ${tip.items.map((i) => i.name).join(', ')}`, tip.note]
      .filter(Boolean)
      .join('\n')
  : undefined;
const tipData = tip ? JSON.stringify(tip) : undefined;
const period = since && (until ? (until === since ? `${since}` : `${since}–${until}`) : `${sinceLabel} ${since}`);
---

<li class:list={['chip', { featured, legacy }]} id={id}>
  <Tag class="inner" href={href} title={title} data-tip={tipData}>
    <span class="name">{name}</span>
    {period && <span class="since">{period}</span>}
  </Tag>
</li>

<style>
  .chip {
    display: inline-flex;
    scroll-margin-top: 8rem;
  }
  .inner {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: 0.3em 0.7em;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-raised);
    font-size: var(--step--1);
    color: var(--text);
    line-height: 1.4;
    text-decoration: none;
    transition:
      border-color 200ms,
      background 200ms,
      box-shadow 400ms;

    .featured & {
      border-color: var(--primary-line);
      background: var(--primary-soft);
    }
    .legacy & {
      border-style: dashed;
      border-color: var(--border-strong);
      background: transparent;
      color: var(--text-muted);
    }
  }
  /* Chips that are links (career page). */
  a.inner {
    &:hover {
      border-color: var(--primary);
      color: var(--primary);
    }
    &:active {
      translate: 0 1px;
      background: var(--primary-soft);
    }
  }
  /* Deep-linked from the career page (#skill-…). */
  .chip:target .inner {
    border-color: var(--primary);
    background: var(--primary-soft);
    box-shadow: 0 0 0 4px var(--primary-soft);
  }
  .since {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--text-subtle);
  }
</style>
