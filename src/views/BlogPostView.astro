---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SkillList from '../components/SkillList.astro';
import CodeCopy from '../components/CodeCopy.astro';
import PostToc from '../components/PostToc.astro';
import { profile, type Locale } from '../data';
import { type Post, postSlug, postUpdated } from '../i18n/blog';
import { blogPostPath, route } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Locale;
  post: Post;
  /** Whether a translation with the same slug exists. */
  hasTranslation: boolean;
}
const { lang, post, hasTranslation }: Props = Astro.props;
const t = useT(lang);
const other: Locale = lang === 'de' ? 'en' : 'de';
const { Content, headings } = await render(post);
/* Table of contents: only for posts with enough sections to be worth it. */
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = headings.filter((h) => h.depth === 2).length >= 4;
const dateFmt = new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-GB', { dateStyle: 'long' });
const updated = postUpdated(post);
const altPath = hasTranslation ? blogPostPath(postSlug(post), other) : route('blog', other);
/* Meta/OG description: the standalone summary, else the description after the title (see content.config.ts). */
const metaDescription = post.data.summary ?? `${post.data.title} – ${post.data.description}`;

/* Structured data for search engines: headline, dates and author (the Person on the home page). */
const site = Astro.site ?? new URL('https://weblogixx.de');
const postUrl = new URL(blogPostPath(postSlug(post), lang), site).href;
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: metaDescription,
  datePublished: post.data.date.toISOString().slice(0, 10),
  dateModified: (post.data.updated ?? post.data.date).toISOString().slice(0, 10),
  inLanguage: lang,
  url: postUrl,
  mainEntityOfPage: postUrl,
  keywords: post.data.tags,
  author: {
    '@type': 'Person',
    name: profile.name,
    url: new URL(route('home', lang), site).href,
  },
};
---

<Base lang={lang} page="blog" title={post.data.title} description={metaDescription} altPath={altPath} translated={hasTranslation} structuredData={blogPosting}>
  <article class="container post">
    <header class="page-head">
      <a class="back" href={route('blog', lang)}>← {t('blog.back')}</a>
      <p class="dates">
        <time datetime={post.data.date.toISOString()}>{dateFmt.format(post.data.date)}</time>
        {
          updated && (
            <span>
              <span class="sep" aria-hidden="true">
                ·
              </span>
              {t('blog.updated')} <time datetime={updated.toISOString()}>{dateFmt.format(updated)}</time>
            </span>
          )
        }
      </p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      {
        post.data.translatedFrom && hasTranslation && (
          <p class="translated">
            {t('blog.translatedFrom')}{' '}
            <a href={blogPostPath(postSlug(post), post.data.translatedFrom)} hreflang={post.data.translatedFrom}>
              {t('blog.readOriginal')} →
            </a>
          </p>
        )
      }
      {post.data.skills.length > 0 && <SkillList ids={post.data.skills} lang={lang} />}
    </header>
    <div class:list={['post-body', { 'has-toc': hasToc }]}>
      {hasToc && <PostToc headings={tocHeadings} label={t('blog.toc')} />}
      <div class="content">
        <Content />
      </div>
    </div>
    <CodeCopy lang={lang} />
  </article>
</Base>

<style>
  .back,
  .dates {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    color: var(--text-subtle);
  }
  /* Small phones: the update gets its own line, without a leading dot. */
  .sep {
    margin-right: var(--space-2);

    @media (max-width: 480px) {
      display: none;
    }
  }
  /* Translations point to the original, quietly, like the date line. */
  .translated {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
  /* Wide screens: text on the left as before, table of contents in the free space next to it. */
  @media (min-width: 1060px) {
    .has-toc {
      display: grid;
      grid-template-columns: minmax(0, 42em) minmax(11rem, 15rem);
      justify-content: space-between;
      column-gap: var(--space-7);

      & > .content {
        grid-column: 1;
        grid-row: 1;
      }
    }
  }
  .content {
    max-width: 42em;
    margin-bottom: var(--space-9);
    display: grid;
    /* minmax(0, …): wide content (figures, code) can never push the page sideways. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);

    /* Markdown output: not part of this component, hence :global. */
    /* Anchor jumps: keep the heading clear of the sticky header. */
    & :global(:is(h2, h3)) {
      scroll-margin-top: var(--space-8);
    }
    & :global(h2) {
      font-size: var(--step-2);
      margin-top: var(--space-5);
    }
    /* Only as a break after text: a post that opens with a heading starts right below the header. */
    & > :global(h2:first-child) {
      margin-top: 0;
    }
    /* Code blocks: .code-block in global.css. */
    & :global(code) {
      font-family: var(--font-mono);
    }
    /*
     * Sunny post: the guitar (cut-out photo, transparent background) with the palette taken
     * from it, side by side: guitar | nine primary steps | three accent steps | Pearloid, all as
     * tall as the guitar – wide next to narrow, like the stripe. Fits down to small phones.
     */
    & :global(.sunny-source) {
      margin: var(--space-4) 0;
      display: grid;
      grid-template-columns: auto minmax(4rem, 7rem) minmax(1.75rem, 2.75rem) minmax(2.25rem, 4rem);
      grid-template-areas:
        'guitar primary accent pearl'
        'caption caption caption caption';
      justify-content: center;
      gap: var(--space-4) var(--space-5);

      @media (max-width: 600px) {
        gap: var(--space-3) var(--space-4);
      }
      /* Phones: a smaller palette with room to spare. Clipped sideways only, as a safety net. */
      @media (max-width: 480px) {
        grid-template-columns: auto minmax(0, 5rem) minmax(0, 2rem) minmax(0, 2.5rem);
        column-gap: var(--space-3);
        overflow-x: clip;
      }
    }
    /* The photo sizes the cell; the traced areas (SunnyGuitar.astro) lie on top of it. */
    & :global(.sunny-guitar) {
      grid-area: guitar;
      position: relative;
    }
    & :global(.sunny-guitar img) {
      width: auto;
      /* The global max-width: 100% would be circular in this auto-sized cell (→ 0 wide). */
      max-width: none;
      height: clamp(20rem, 60vw, 32rem);

      @media (max-width: 480px) {
        height: clamp(15rem, 74vw, 20rem);
      }
    }
    /* Larger than the photo by --pad-x/-y (set in SunnyGuitar.astro) so Safari doesn't clip the
       halo; only the shapes take the pointer, not the padding over the gap. */
    & :global(.sunny-guitar svg) {
      position: absolute;
      top: calc(-1 * var(--pad-y));
      left: calc(-1 * var(--pad-x));
      /* Explicit size: an absolutely positioned <svg> may not stretch between its insets. */
      width: calc(100% + 2 * var(--pad-x));
      height: calc(100% + 2 * var(--pad-y));
      max-width: none;
      overflow: visible;
      pointer-events: none;
    }
    & :global(.sunny-guitar .spot) {
      pointer-events: auto;
    }
    & :global(.sunny-source .swatches) {
      grid-area: primary;
      display: grid;
      grid-template-rows: repeat(9, 1fr);
      border-radius: var(--radius-m);
      overflow: hidden;
    }
    & :global(.sunny-source .swatches.accent) {
      grid-area: accent;
      grid-template-rows: repeat(3, 1fr);
    }
    /* The pickguard's material, live. The color shows until the Pearloid is drawn. */
    & :global(.sunny-pearl) {
      --glow: transparent;
      grid-area: pearl;
      position: relative;
      isolation: isolate;
      overflow: hidden;
      border-radius: var(--radius-m);
      background: light-dark(#d4cabb, #211b13);
      box-shadow: 0 0 1.1rem var(--glow);
      transition: box-shadow 200ms;
    }
    /*
     * Guitar ↔ palette: hovering (or focusing/tapping) the body or a primary swatch makes the
     * body and the primary column glow in the primary color; the stripe or an accent swatch
     * does the same in the accent color, the pickguard or Pearloid column in pearl. The traced shapes (.spot) are invisible hit areas;
     * the halo (.glow, an SVG filter in SunnyGuitar.astro) only appears outside the shape's
     * edge. The stripe lies on top of the body and wins.
     */
    & :global(.spot) {
      fill: transparent;
      cursor: pointer;
      outline: none;
    }
    & :global(.glow) {
      opacity: 0;
      pointer-events: none;
      transition: opacity 200ms;
    }
    & :global(.flood-primary) {
      flood-color: var(--primary);
    }
    & :global(.flood-accent) {
      flood-color: var(--accent);
    }
    & :global(.flood-pearl) {
      flood-color: light-dark(#fff, #fff4dc);
    }
    & :global(.sunny-source .swatches) {
      --glow: transparent;
      box-shadow: 0 0 1.1rem var(--glow);
      transition: box-shadow 200ms;
    }
    & :global(.sunny-source:has(.spot-body:is(:hover, :focus-visible), .swatches:not(.accent):hover)) {
      & :global(.glow-body) {
        opacity: 1;
      }
      & :global(.swatches:not(.accent)) {
        --glow: color-mix(in oklch, var(--primary) 70%, transparent);
      }
    }
    & :global(.sunny-source:has(.spot-stripe:is(:hover, :focus-visible), .swatches.accent:hover)) {
      & :global(.glow-stripe) {
        opacity: 1;
      }
      & :global(.swatches.accent) {
        --glow: color-mix(in oklch, var(--accent) 75%, transparent);
      }
    }
    & :global(.sunny-source:has(.spot-pickguard:is(:hover, :focus-visible), .sunny-pearl:hover)) {
      & :global(.glow-pickguard) {
        opacity: 1;
      }
      & :global(.sunny-pearl) {
        --glow: light-dark(color-mix(in oklch, #8f7f66 65%, transparent), color-mix(in oklch, #fff4dc 70%, transparent));
      }
    }
    & :global(.sunny-source figcaption) {
      grid-area: caption;
      text-align: center;
      /* Wraps to the guitar + palette width instead of widening the columns. */
      contain: inline-size;
    }
    & :global(figcaption) {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: var(--text-subtle);
      hyphens: manual;
    }
    /* Lists: the grid gap already spaces them; the default margin would double it. */
    & :global(:is(ul, ol)) {
      margin: 0;
    }
  }
</style>
