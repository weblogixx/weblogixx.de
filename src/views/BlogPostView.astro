---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SkillList from '../components/SkillList.astro';
import CodeCopy from '../components/CodeCopy.astro';
import type { Locale } from '../data';
import { type Post, postSlug } from '../i18n/blog';
import { blogPostPath, route } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Locale;
  post: Post;
  /** Whether a translation with the same slug exists. */
  hasTranslation: boolean;
}
const { lang, post, hasTranslation } = Astro.props;
const t = useT(lang);
const other: Locale = lang === 'de' ? 'en' : 'de';
const { Content } = await render(post);
const dateFmt = new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-GB', { dateStyle: 'long' });
const altPath = hasTranslation ? blogPostPath(postSlug(post), other) : route('blog', other);
---

<Base lang={lang} page="blog" title={post.data.title} description={post.data.description} altPath={altPath}>
  <article class="container post">
    <header class="page-head">
      <a class="back" href={route('blog', lang)}>← {t('blog.back')}</a>
      <time datetime={post.data.date.toISOString()}>{dateFmt.format(post.data.date)}</time>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      {post.data.skills.length > 0 && <SkillList ids={post.data.skills} lang={lang} />}
    </header>
    <div class="content">
      <Content />
    </div>
    <CodeCopy lang={lang} />
  </article>
</Base>

<style>
  .back,
  time {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  time {
    color: var(--text-subtle);
  }
  .content {
    max-width: 42em;
    margin-bottom: var(--space-9);
    display: grid;
    gap: var(--space-4);

    /* Markdown output: not part of this component, hence :global. */
    & :global(h2) {
      font-size: var(--step-2);
      margin-top: var(--space-5);
    }
    /* Code blocks: .code-block in global.css. */
    & :global(code) {
      font-family: var(--font-mono);
    }
    /*
     * Sunny post: the guitar (cut-out photo, transparent background) with the palette taken
     * from it, side by side: guitar | nine primary steps | three accent steps, all as tall as
     * the guitar – wide next to narrow, like the stripe. Fits down to small phones.
     */
    & :global(.sunny-source) {
      margin: var(--space-4) 0;
      display: grid;
      grid-template-columns: auto minmax(4rem, 7rem) minmax(1.75rem, 2.75rem);
      grid-template-areas:
        'guitar primary accent'
        'caption caption caption';
      justify-content: center;
      gap: var(--space-4) var(--space-5);

      @media (max-width: 600px) {
        gap: var(--space-3) var(--space-4);
      }
    }
    & :global(.sunny-source img) {
      grid-area: guitar;
      width: auto;
      height: clamp(20rem, 60vw, 32rem);
    }
    & :global(.sunny-source .swatches) {
      grid-area: primary;
      display: grid;
      grid-template-rows: repeat(9, 1fr);
      border-radius: var(--radius-m);
      overflow: hidden;
    }
    & :global(.sunny-source .swatches.accent) {
      grid-area: accent;
      grid-template-rows: repeat(3, 1fr);
    }
    & :global(.sunny-source figcaption) {
      grid-area: caption;
      text-align: center;
      /* Wraps to the guitar + palette width instead of widening the columns. */
      contain: inline-size;
    }
    & :global(figcaption) {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: var(--text-subtle);
    }
  }
</style>
