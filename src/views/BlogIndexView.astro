---
import Base from '../layouts/Base.astro';
import SkillList from '../components/SkillList.astro';
import type { Locale } from '../data';
import { getListedPosts, postLang, postSlug, postUpdated } from '../i18n/blog';
import { blogPostPath, feedPath } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useT(lang);
const posts = await getListedPosts(lang);
const dateFmt = new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-GB', { dateStyle: 'long' });
---

<Base lang={lang} page="blog" title={t('blog.title')}>
  <div class="container">
    <header class="page-head">
      <h1>{t('blog.title')}</h1>
      <p class="lede">{t('blog.lede')}</p>
      <a class="feed" href={feedPath(lang)} type="application/rss+xml">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1.5" />
        </svg>
        {t('blog.feed')}
      </a>
    </header>

    {
      posts.length === 0 ? (
        <p class="empty">{t('blog.empty')}</p>
      ) : (
        <ul class="posts">
          {posts.map((p) => {
            /* A post without a version in this language links to the one that exists. */
            const pLang = postLang(p);
            const foreign = pLang !== lang;
            const updated = postUpdated(p);
            const aiItems = (p.data.ai ?? []).map((kind) => ({ name: t(`blog.ai.${kind}`) }));
            const aiText = `${t('blog.aiDescription')} ${t('blog.aiLabel')}: ${aiItems.map((i) => i.name).join(', ')}`;
            return (
              <li>
                <a href={blogPostPath(postSlug(p), pLang)} hreflang={foreign ? pLang : undefined}>
                  <span class="meta">
                    <time datetime={p.data.date.toISOString()}>{dateFmt.format(p.data.date)}</time>
                    {updated && (
                      <span class="updated">
                        <span class="sep" aria-hidden="true">
                          ·
                        </span>
                        {t('blog.updated')} <time datetime={updated.toISOString()}>{dateFmt.format(updated)}</time>
                      </span>
                    )}
                    {foreign && (
                      <span
                        class="tag"
                        title={t('blog.otherLang')}
                        data-tip={JSON.stringify({ text: t('blog.otherLang'), label: '', items: [] })}
                      >
                        {pLang.toUpperCase()}
                        <span class="visually-hidden"> – {t('blog.otherLang')}</span>
                      </span>
                    )}
                    {aiItems.length > 0 && (
                      <span
                        class="tag"
                        title={aiText}
                        data-tip={JSON.stringify({ text: t('blog.aiDescription'), label: t('blog.aiLabel'), items: aiItems })}
                      >
                        {t('blog.ai')}
                        <span class="visually-hidden"> – {aiText}</span>
                      </span>
                    )}
                  </span>
                  <span class="title" lang={foreign ? pLang : undefined}>
                    {p.data.title}
                    {p.data.draft && <em> (draft)</em>}
                  </span>
                  <span class="desc" lang={foreign ? pLang : undefined}>{p.data.description}</span>
                  {/* Not linked: the whole entry is already a link. */}
                  {p.data.skills.length > 0 && (
                    <span class="skills">
                      <SkillList ids={p.data.skills} lang={lang} linked={false} />
                    </span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .feed {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);

    & svg {
      width: 1em;
      height: 1em;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.5;
      stroke-linecap: round;
    }
    & circle {
      fill: currentColor;
      stroke: none;
    }
  }
  .empty {
    padding: var(--space-6);
    margin-bottom: var(--space-9);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-l);
    color: var(--text-muted);
  }
  .posts {
    list-style: none;
    margin: 0 0 var(--space-9);
    padding: 0;
    display: grid;
  }
  /* Descendants stay flat: Astro doesn't scope nested ones (see README → Styles). */
  .posts a {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
  }
  time {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }
  .updated {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
  /* Small phones: the update gets its own line, without a leading dot. */
  .sep {
    margin-right: var(--space-2);

    @media (max-width: 480px) {
      display: none;
    }
  }
  /* Small tags with a tooltip: the post's other language, AI assistance. */
  .tag {
    padding: 0 0.4em;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--text-muted);
    cursor: help;
  }
  .title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
  }
  .posts a:hover .title {
    color: var(--primary);
  }
  .desc {
    color: var(--text-muted);
  }
  .skills {
    margin-top: var(--space-2);
  }
</style>
