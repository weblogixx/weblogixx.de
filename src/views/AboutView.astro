---
import Base from '../layouts/Base.astro';
import { profile, type Locale } from '../data';
import { useT } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<Base lang={lang} page="about" title={t('about.title')}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">{profile.handle}</p>
      <h1>{t('about.title')}</h1>
    </header>

    <div class="prose about">
      {profile.about[lang].map((p) => <p>{p}</p>)}
    </div>
  </div>
</Base>

<style>
  .about {
    font-size: var(--step-1);
    /* Room above the footer once the text gets long (same as blog posts). */
    margin-bottom: var(--space-9);
  }
</style>
