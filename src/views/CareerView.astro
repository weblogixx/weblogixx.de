---
import Base from '../layouts/Base.astro';
import CompanyLogo from '../components/CompanyLogo.astro';
import SkillList from '../components/SkillList.astro';
import HelloCta from '../components/HelloCta.astro';
import { career, formatPeriod, yearOf, type Locale } from '../data';
import { brandScope, themeDataAttrs, sunny } from '../theme/color';
import { useT } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useT(lang);
const firstYear = Math.min(...career.map((e) => yearOf(e.start)));
---

<Base lang={lang} page="career" title={t('career.title')}>
  <div class="container">
    <header class="page-head" data-tint {...themeDataAttrs('Sunny', sunny)}>
      <p class="eyebrow">
        {firstYear} – {lang === 'de' ? 'heute' : 'today'}
      </p>
      <h1>{t('career.title')}</h1>
      <p class="lede">{t('career.lede')}</p>
    </header>

    <ol class="career">
      {career.map((e) => (
        <li
          class="job"
          id={e.id}
          data-tint
          data-handle={e.handle ?? e.id}
          {...themeDataAttrs(e.colors ? e.name : 'Sunny', e.theme)}
          {...brandScope(e.theme)}
        >
          <aside class="meta">
            <div class="meta-sticky">
              <span class="marker stripe-marker" aria-hidden="true" />
              {/* Full logo; on small phones the square tile from the home page instead, so the
                  period and location fit next to it. The hidden one isn't loaded (lazy). */}
              <span class="logo-full">
                <CompanyLogo
                  name={e.name}
                  logo={e.logo}
                  mark={e.logoMark}
                  background={e.logoBackground}
                  bleed={e.logoBleed}
                  color={e.colors?.primary}
                  variant="full"
                />
              </span>
              <span class="logo-mark">
                <CompanyLogo
                  name={e.name}
                  mark={e.logoMark}
                  background={e.logoBackground}
                  bleed={e.logoBleed}
                  color={e.colors?.primary}
                />
              </span>
              <div class="meta-text">
                <p class="period">{formatPeriod(e, lang)}</p>
                {e.current && <p class="badge">{t('career.current')}</p>}
                {e.selfEmployed && <p class="badge">{t('career.selfEmployed')}</p>}
                {e.location && <p class="location">{e.location}</p>}
                {e.clientProjects && (
                  <p class="client-projects">
                    <strong>{e.clientProjects.toLocaleString(lang)}</strong> {t('career.clientProjects')}
                  </p>
                )}
              </div>
            </div>
          </aside>

          <article class="body">
            <header>
              <h2>{e.name}</h2>
              <p class="role">{e.role[lang]}</p>
            </header>

            {e.positions.length > 1 && (
              <section>
                <h3>{t('career.positions')}</h3>
                <ol class="positions">
                  {e.positions.map((p, i) => (
                    <li class:list={{ latest: i === 0 }}>
                      <span class="pos-period">{formatPeriod(p, lang)}</span>
                      <span class="pos-role">{p.role[lang]}</span>
                      {p.summary && <span class="pos-summary">{p.summary[lang]}</span>}
                    </li>
                  ))}
                </ol>
              </section>
            )}

            <div class="prose">
              {e.about[lang].map((p) => <p>{p}</p>)}
            </div>

            {e.contributions[lang].length > 0 && (
              <section>
                <h3>{t('career.contributions')}</h3>
                <ul class="contrib">
                  {e.contributions[lang].map((c) => <li>{c}</li>)}
                </ul>
              </section>
            )}

            {e.facts && e.facts.length > 0 && (
              <dl class="facts">
                {e.facts.map((f) => (
                  <div>
                    <dt>{f.label[lang]}</dt>
                    <dd>{typeof f.value === 'string' ? f.value : f.value[lang]}</dd>
                  </div>
                ))}
              </dl>
            )}

            <section>
              <h3>{t('career.stack')}</h3>
              <SkillList ids={e.stack} lang={lang} />
            </section>

            {e.links && e.links.length > 0 && (
              <ul class="extra-links">
                {e.links.map((l) => (
                  <li>
                    <a href={l.url} rel="noopener" target="_blank">
                      {l.label} ↗
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {e.url && (
              <a class="site" href={e.url} rel="noopener" target="_blank">
                {t('career.website')}: {new URL(e.url).host} ↗
              </a>
            )}
          </article>
        </li>
      ))}
    </ol>
  </div>
  <HelloCta lang={lang} variant="block" />
</Base>

<script>
  import { initTint } from '../theme/tint';
  initTint();
</script>

<style>
  /*
   * A soft glow under the header, only on this page. Fixed (stays put while scrolling) and
   * behind the content, so nothing is covered – unlike a box-shadow on the header.
   * --border is tinted towards the active company's hue, so the glow follows the tinting.
   * isolation: the body has its own background, which would cover a z-index:-1 layer;
   * this keeps the glow above it but below main's content.
   */
  :global(main[data-page='career']) {
    isolation: isolate;

    &::before {
      content: '';
      position: fixed;
      inset: 0 0 auto;
      height: 14rem;
      /* Dark: lighter than the background (--border) reads as a glow. Light: anything darker
         reads as a shadow, so use a faint brand tint instead, like the home page hero. */
      background: radial-gradient(
        ellipse 70% 100% at 50% 0,
        light-dark(var(--primary-soft), var(--border)),
        transparent 70%
      );
      pointer-events: none;
      z-index: -1;
    }
  }

  .career {
    list-style: none;
    margin: 0 0 var(--space-9);
    padding: 0;
  }
  .job {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: var(--space-7);
    --job-pad: var(--space-8);
    padding-block: var(--job-pad);
    /* The divider line starts after the marker (with the stripes' 4px gap), so it doesn't
       show through between the stripes. Transparent border keeps the 1px of spacing. */
    border-top: 1px solid transparent;
    background: linear-gradient(var(--border), var(--border)) no-repeat 106px 0 / 100% 1px;
    background-origin: border-box;
    position: relative;
    scroll-margin-top: calc(4rem + env(safe-area-inset-top, 0px));

    @media (max-width: 760px) {
      /* minmax(0, …): a long word (CLICKSPORTS) must not widen the column past the screen. */
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
      --job-pad: var(--space-7);
    }
  }
  /*
   * Section marker (drawn by .stripe-marker in global.css). It's the first item of
   * .meta-sticky, so marker and logo stick (and leave) as one unit instead of the logo
   * sliding through a separately stuck marker.
   */
  .marker {
    /* Keeps the logo where it was: marker + this + the grid gap = job padding + 1px border. */
    margin-bottom: calc(var(--job-pad) + 1px - 8px - var(--space-2));

    /* No sticking on phones: the marker goes back to the job's top edge, out of the row. */
    @media (max-width: 760px) {
      position: absolute;
      top: -1px;
      left: 0;
      margin: 0;
    }
  }
  .meta-sticky {
    position: sticky;
    /* Right below the header (4rem + its 1px border + the notch area it covers). */
    top: calc(4rem + 1px + env(safe-area-inset-top, 0px));
    /* Pulled up through the job's top padding, so the marker sits on the job's top edge. */
    margin-top: calc(-1 * var(--job-pad) - 1px);
    display: grid;
    gap: var(--space-2);
    justify-items: start;

    @media (max-width: 760px) {
      margin-top: 0;
      position: static;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-4);
    }
  }
  .logo-full {
    display: contents;

    @media (max-width: 480px) {
      display: none;
    }
  }
  .logo-mark {
    display: none;

    @media (max-width: 480px) {
      display: contents;
    }
  }
  .meta-text {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .period {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text);

    @media (max-width: 760px) {
      margin-top: 0;
    }
  }
  .location {
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
  .client-projects {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  /* Descendants stay flat: Astro doesn't scope nested ones (see README → Styles). */
  .client-projects strong {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--primary);
  }
  .badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    background: var(--primary-fill);
    color: var(--primary-contrast);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    min-width: 0;
  }
  h2 {
    font-size: var(--step-4);
    color: var(--primary);
  }
  .role {
    margin-top: var(--space-2);
    font-size: var(--step-1);
    color: var(--text);
  }
  h3 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-3);
  }
  .positions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-left: 2px solid var(--border);
  }
  .positions li {
    position: relative;
    display: grid;
    gap: 0.1rem;
    padding: 0 0 var(--space-4) var(--space-5);

    &:last-child {
      padding-bottom: 0;
    }
    /* Timeline dot on the left line; filled for the latest position. */
    &::before {
      content: '';
      position: absolute;
      left: calc(-0.35rem - 1px);
      top: 0.45em;
      width: 0.7rem;
      height: 0.7rem;
      border-radius: 50%;
      background: var(--bg);
      border: 2px solid var(--border-strong);
    }
    &.latest::before {
      background: var(--primary-fill);
      border-color: var(--primary);
    }
  }
  .pos-period {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
  .pos-role {
    font-weight: 600;

    .latest & {
      color: var(--primary);
    }
  }
  .pos-summary {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .contrib {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
    max-width: 42em;
  }
  .contrib li {
    position: relative;
    padding-left: var(--space-5);

    /* Short accent dash as the bullet. */
    &::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.7em;
      width: 0.8rem;
      height: 3px;
      border-radius: 2px;
      background: var(--accent);
    }
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
  }
  .facts div {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--bg-raised);
    min-width: 8rem;
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
  }
  .extra-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .site {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
