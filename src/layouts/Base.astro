---
import '../styles/global.css';
// Same files as src/styles/fonts.css → preloaded so they're ready for the first frame.
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import displayFont from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tooltip from '../components/Tooltip.astro';
import type { Locale } from '../data/types';
import { profile } from '../data';
import { routes, href, type RouteKey } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Locale;
  page: RouteKey;
  title?: string;
  description?: string;
  /** Alternate-language URL when it isn't the plain route (blog posts). */
  altPath?: string;
}

const { lang, page, title, description, altPath } = Astro.props;
const t = useT(lang);
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.title[lang]}`;
const desc = description ?? profile.intro[lang];
const other: Locale = lang === 'de' ? 'en' : 'de';
const altHref = altPath ?? href(routes[page][other]);
const site = Astro.site ?? new URL('https://weblogixx.de');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover: the page (and the header's background) reaches into the notch / status
        bar area; the header, container and footer pad themselves by the safe-area insets. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#faf6ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1813" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Runs before first paint:
      // - data-js lets CSS lay out JS-only controls (mode toggle, mobile menu) from the first frame,
      //   so the header doesn't jump when their scripts load.
      // - Apply a saved light/dark choice (no flash). Without one, CSS follows the OS setting.
      document.documentElement.dataset.js = '';
      (() => {
        try {
          const mode = localStorage.getItem('sunny-mode');
          if (mode === 'light' || mode === 'dark') {
            document.documentElement.dataset.mode = mode;
            const color = mode === 'light' ? '#faf6ee' : '#1c1813';
            for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.content = color;
          }
        } catch {}
      })();
      // iOS Safari only applies :active (pressed states) when the page listens for touches.
      document.addEventListener('touchstart', () => {}, { passive: true });
    </script>
    {
      [interFont, monoFont, displayFont].map((font) => (
        <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
      ))
    }
    {/* ICO (16/32/48 px, rendered from the SVG) for browsers without SVG favicons; the rest pick the SVG. */}
    <link rel="icon" href={href('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, site)} />
    <link rel="alternate" hreflang={other} href={new URL(altHref, site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} page={page} altPath={altPath} />
    <main id="main" data-page={page}>
      <slot />
    </main>
    <Footer lang={lang} />
    <Tooltip />
  </body>
</html>

<style>
  .skip:focus {
    position: fixed !important;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 100;
    width: auto;
    height: auto;
    clip: auto;
    padding: var(--space-2) var(--space-4);
    background: var(--primary-fill);
    color: var(--primary-contrast);
    border-radius: var(--radius-s);
  }
</style>
