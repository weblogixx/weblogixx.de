---
import BlogPostView from '../../views/BlogPostView.astro';
import { getPosts, getVisiblePosts, postSlug, postLang, type Post } from '../../i18n/blog';

export async function getStaticPaths() {
  const posts = await getPosts('de');
  const other = new Set((await getVisiblePosts()).filter((p) => postLang(p) !== 'de').map(postSlug));
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post, hasTranslation: other.has(postSlug(post)) },
  }));
}

interface Props {
  post: Post;
  hasTranslation: boolean;
}
const { post, hasTranslation }: Props = Astro.props;
---

<BlogPostView lang="de" post={post} hasTranslation={hasTranslation} />
