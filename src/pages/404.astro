---
/**
 * Not-found page. Built as /404.html; Apache serves it for unknown URLs (ErrorDocument in
 * public/.htaccess). One page for both languages, since the URL doesn't tell which one fits.
 */
import Link from '../components/Link.astro';
import Base from '../layouts/Base.astro';
import { route } from '../i18n/routes';
---

<Base lang="de" page="home" title="Seite nicht gefunden">
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">404</p>
      <h1>Seite nicht gefunden</h1>
      <p class="lede">
        Diese Adresse gibt es nicht (mehr). <Link href={route('home', 'de')}>Zur Startseite</Link>
      </p>
      <p class="lede" lang="en">
        This page doesn't exist (anymore). <Link href={route('home', 'en')}>Go to the home page</Link>
      </p>
    </header>
  </div>
</Base>
