{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "import/no-unassigned-import": "off"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist/**", ".astro/**"]
}
